{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trukeados",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "game.trukeados.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "TRUCO_ROOM", "class_name": "TrucoRoom" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TrucoRoom", "Lobby"] }],
  "observability": { "enabled": true },
  // Límite de pedidos a /api (Workers Rate Limiting; el período solo puede ser 10 o 60 s). Ver src/limits.js.
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "WRITE_LIMIT", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } }
  ],
  // Supabase (cuentas y base de datos). Estos dos son públicos: el navegador los usa para iniciar sesión.
  // La clave secreta va aparte, como secreto: npx wrangler secret put SUPABASE_SECRET_KEY (ver docs/CUENTAS.md).
  "vars": {
    "SUPABASE_URL": "https://kvcmmwtptgpwnxjqlpxh.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_FSuHcj4rHi1f4AjywOh1zw_rpwzoGsm"
  }
}
