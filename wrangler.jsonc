{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trukeados",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "TRUCO_ROOM", "class_name": "TrucoRoom" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TrucoRoom", "Lobby"] }],
  "observability": { "enabled": true }
}
